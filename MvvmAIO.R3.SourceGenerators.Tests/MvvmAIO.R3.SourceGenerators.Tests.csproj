<Project Sdk="Microsoft.NET.Sdk">



  <PropertyGroup>

    <TargetFramework>net8.0</TargetFramework>

    <IsPackable>false</IsPackable>

    <Nullable>enable</Nullable>

    <LangVersion>latest</LangVersion>

    <RootNamespace>MvvmAIO.R3.SourceGenerators.Tests</RootNamespace>



    <MvvmAIOR3SourceGeneratorsRoslynProject Condition="'$(MvvmAIOR3SourceGeneratorsRoslynProject)' == ''">MvvmAIO.R3.SourceGenerators.Roslyn4120</MvvmAIOR3SourceGeneratorsRoslynProject>

    <MvvmAIOR3SourceGeneratorsRoslynFlavor Condition="$(MvvmAIOR3SourceGeneratorsRoslynProject.Contains('4031'))">4031</MvvmAIOR3SourceGeneratorsRoslynFlavor>

    <MvvmAIOR3SourceGeneratorsRoslynFlavor Condition="$(MvvmAIOR3SourceGeneratorsRoslynProject.Contains('4120'))">4120</MvvmAIOR3SourceGeneratorsRoslynFlavor>

    <MvvmAIOR3SourceGeneratorsRoslynFlavor Condition="$(MvvmAIOR3SourceGeneratorsRoslynProject.Contains('5000'))">5000</MvvmAIOR3SourceGeneratorsRoslynFlavor>

    <MvvmAIOR3SourceGeneratorsTestsRoslynVersion Condition="'$(MvvmAIOR3SourceGeneratorsRoslynProject)' == 'MvvmAIO.R3.SourceGenerators.Roslyn4031'">4.3.1</MvvmAIOR3SourceGeneratorsTestsRoslynVersion>

    <MvvmAIOR3SourceGeneratorsTestsRoslynVersion Condition="'$(MvvmAIOR3SourceGeneratorsRoslynProject)' == 'MvvmAIO.R3.SourceGenerators.Roslyn4120'">4.12.0</MvvmAIOR3SourceGeneratorsTestsRoslynVersion>

    <MvvmAIOR3SourceGeneratorsTestsRoslynVersion Condition="'$(MvvmAIOR3SourceGeneratorsRoslynProject)' == 'MvvmAIO.R3.SourceGenerators.Roslyn5000'">5.0.0</MvvmAIOR3SourceGeneratorsTestsRoslynVersion>

    <MvvmAIOR3SourceGeneratorsTestsRoslynVersion Condition="'$(MvvmAIOR3SourceGeneratorsTestsRoslynVersion)' == ''">4.12.0</MvvmAIOR3SourceGeneratorsTestsRoslynVersion>

  </PropertyGroup>



  <ItemGroup>

    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />

    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="$(MvvmAIOR3SourceGeneratorsTestsRoslynVersion)" />

    <PackageReference Include="R3" Version="1.3.0" />

    <PackageReference Include="Verify.XunitV3" Version="31.16.2" />

    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">

      <PrivateAssets>all</PrivateAssets>

      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>

    </PackageReference>

    <PackageReference Include="xunit.v3" Version="3.2.2" />

  </ItemGroup>



  <ItemGroup>

    <ProjectReference Include="..\$(MvvmAIOR3SourceGeneratorsRoslynProject)\$(MvvmAIOR3SourceGeneratorsRoslynProject).csproj" />

  </ItemGroup>



  <Target Name="GenerateRoslynTestConfig" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_RoslynTestConfigFile>$(MSBuildThisFileDirectory)Infrastructure\RoslynTestConfig.g.cs</_RoslynTestConfigFile>
    </PropertyGroup>
    <ItemGroup>
      <_RoslynTestConfigLine Include="// &lt;auto-generated/&gt; This file is overwritten by MSBuild." />
      <_RoslynTestConfigLine Include="namespace MvvmAIO.R3.SourceGenerators.Tests.Infrastructure%3B" />
      <_RoslynTestConfigLine Include="internal static class RoslynTestConfig" />
      <_RoslynTestConfigLine Include="{" />
      <_RoslynTestConfigLine Include="    public const string Flavor = &quot;$(MvvmAIOR3SourceGeneratorsRoslynFlavor)&quot;%3B" />
      <_RoslynTestConfigLine Include="    public const string CodeAnalysisVersion = &quot;$(MvvmAIOR3SourceGeneratorsTestsRoslynVersion)&quot;%3B" />
      <_RoslynTestConfigLine Include="    public const string AnalyzerProject = &quot;$(MvvmAIOR3SourceGeneratorsRoslynProject)&quot;%3B" />
      <_RoslynTestConfigLine Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(_RoslynTestConfigFile)" Lines="@(_RoslynTestConfigLine)" Overwrite="true" />
  </Target>



</Project>


