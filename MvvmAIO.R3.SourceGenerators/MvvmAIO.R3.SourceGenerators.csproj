<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>

    <!-- XML doc emitted next to the analyzer DLL build output; NuGet packs it via Package project into analyzers/dotnet/cs -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Analyzer surface is intentionally small — avoid CS1591 noise for internals without summaries -->
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all">
      <Version>5.3.0</Version>
    </PackageReference>
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all">
      <Version>5.3.0</Version>
    </PackageReference>
  </ItemGroup>

</Project>
